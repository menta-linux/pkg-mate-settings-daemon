From c575333eb75e944801cfe3caf09f4dd7820a28dc Mon Sep 17 00:00:00 2001
From: Mike Gabriel <mike.gabriel@das-netzwerkteam.de>
Date: Wed, 18 Dec 2019 09:11:12 +0100
Subject: [PATCH] RDA: Don't apply stored monitor configuration if session is
 remote.

Description: refreshed for 1.29.1 (context changes in configure.ac and xrandr Makefile.am)
---
Index: src/configure.ac
===================================================================
--- src.orig/configure.ac
+++ src/configure.ac
@@ -60,6 +60,7 @@ LIBMATEKBD_REQUIRED_VERSION=1.17.0
 LIBNOTIFY_REQUIRED_VERSION=0.7.0
 LIBATSPI_REQUIRED_VERSION=2.0
 LIBMATEMIXER_REQUIRED_VERSION=1.10.0
+RDA_REQUIRED_VERSION=0.0.3
 APPINDICATOR_REQUIRED=0.0.13
 
 PKG_CHECK_MODULES(SETTINGS_DAEMON,
@@ -484,6 +485,15 @@ fi
 AM_CONDITIONAL(BUILD_RFKILL, [test x"$enable_rfkill" = x"yes"])
 
 # ---------------------------------------------------------------------------
+# - Check if Remote Desktop Awareness support is available
+# ---------------------------------------------------------------------------
+
+PKG_CHECK_MODULES(RDA, rda >= $RDA_REQUIRED_VERSION, have_rda=yes, have_rda=no)
+if test "x$have_rda" = "xyes"; then
+  AC_DEFINE(HAVE_RDA, 1, [Have the Remote Desktop Awareness library])
+fi
+
+# ---------------------------------------------------------------------------
 # Enable Profiling
 # ---------------------------------------------------------------------------
 AC_ARG_ENABLE(profiling,
@@ -612,4 +622,5 @@ ${NSS_DATABASE:+\
     System nssdb ............: ${NSS_DATABASE}
 }\
     Profiling support .......: ${enable_profiling}
+    RD awareness ............: ${have_rda}
 "
Index: src/plugins/xrandr/Makefile.am
===================================================================
--- src.orig/plugins/xrandr/Makefile.am
+++ src/plugins/xrandr/Makefile.am
@@ -60,6 +60,7 @@ libxrandr_la_CPPFLAGS =						\
 libxrandr_la_CFLAGS =			\
 	$(SETTINGS_PLUGIN_CFLAGS)	\
 	$(LIBNOTIFY_CFLAGS)		\
+	$(RDA_CFLAGS)			\
 	$(MATE_DESKTOP_CFLAGS)		\
 	$(AM_CFLAGS)			\
 	$(WARN_CFLAGS)
@@ -70,6 +71,7 @@ libxrandr_la_LDFLAGS = 			\
 libxrandr_la_LIBADD  =			\
 	$(SETTINGS_PLUGIN_LIBS)		\
 	$(LIBNOTIFY_LIBS)		\
+	$(RDA_LIBS)			\
 	$(MATE_DESKTOP_LIBS)		\
 	$(X11_LIBS)			\
 	$(NULL)
Index: src/plugins/xrandr/msd-xrandr-manager.c
===================================================================
--- src.orig/plugins/xrandr/msd-xrandr-manager.c
+++ src/plugins/xrandr/msd-xrandr-manager.c
@@ -52,6 +52,10 @@
 #include <libnotify/notify.h>
 #endif
 
+#ifdef HAVE_RDA
+#include <rda/rda.h>
+#endif
+
 #include "mate-settings-profile.h"
 #include "msd-xrandr-manager.h"
 
@@ -2472,6 +2476,12 @@ apply_intended_configuration (MsdXrandrM
         GError *my_error;
         gboolean result;
 
+#ifdef HAVE_RDA
+	if (rda_session_is_remote()) {
+		return FALSE;
+	}
+#endif
+
         my_error = NULL;
         result = apply_configuration_from_filename (manager, intended_filename, TRUE, timestamp, &my_error);
         if (!result) {
